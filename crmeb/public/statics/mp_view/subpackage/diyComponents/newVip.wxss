.newVip {
  padding: 0 20rpx 40rpx;
  border-radius: 16rpx;
  background: #ffffff;
}
.newVip .header {
  height: 96rpx;
}
.newVip .header .title {
  font-weight: bold;
  font-size: 32rpx;
  color: #333333;
}
.newVip .header .more {
  font-size: 24rpx;
  color: #999999;
}
.newVip .header .iconfont {
  font-size: 24rpx;
}
.newVip .bonus {
  border: 1rpx solid var(--view-theme);
  border-radius: 17rpx;
  background: var(--view-theme);
}
.newVip .bonus .inner {
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  color: #333333;
}
.newVip .bonus .image {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}
.newVip .bonus .red {
  color: var(--view-theme);
}
.newVip .coupon .title {
  padding: 28rpx 0 20rpx;
  font-weight: bold;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
}
.newVip .coupon .content {
  position: relative;
  padding: 12rpx 190rpx 12rpx 12rpx;
  border-radius: 24rpx;
  background: linear-gradient(270deg, var(--view-theme) 0%, var(--view-gradient) 100%);
}
.newVip .coupon .list {
  flex-wrap: nowrap;
}
.newVip .coupon .item {
  flex-shrink: 0;
  position: relative;
  width: 144rpx;
  height: 188rpx;
  border-radius: 12rpx;
  margin-top: 0;
  margin-right: 8rpx;
  background: radial-gradient(circle at left center, transparent 6rpx, #ffffff 6rpx) top left, radial-gradient(circle at right center, transparent 6rpx, #ffffff 6rpx) top right;
  background-repeat: no-repeat;
  background-size: 78rpx 188rpx;
}
.newVip .coupon .item::before {
  content: "";
  position: absolute;
  top: 94rpx;
  right: 10rpx;
  left: 10rpx;
  border-top: 1rpx dashed #d8d8d8;
}
.newVip .coupon .item .item-top,
.newVip .coupon .item .item-bottom {
  height: 94rpx;
}
.newVip .coupon .item .money {
  font-weight: 500;
  font-size: 28rpx;
  color: var(--view-theme);
}
.newVip .coupon .item .number {
  font-family: SemiBold;
  font-size: 40rpx;
}
.newVip .coupon .item .name {
  font-weight: 500;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--view-theme);
}
.newVip .coupon .item .info {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 26rpx;
  color: #666666;
}
.newVip .coupon .station {
  position: absolute;
  top: 0;
  right: 0;
  width: 190rpx;
  height: 100%;
  padding-top: 40rpx;
  border-radius: 0 24rpx 24rpx 0;
  background: linear-gradient(270deg, var(--view-theme) 0%, var(--view-gradient) 100%);
}
.newVip .coupon .station::before {
  content: "";
  position: absolute;
  top: 0;
  left: -20rpx;
  width: 20rpx;
  height: 210rpx;
  background: linear-gradient(270deg, rgba(0, 0, 0, 0.2) 0%, rgba(255, 255, 255, 0) 100%);
}
.newVip .coupon .station .money {
  text-align: center;
  font-weight: 500;
  font-size: 28rpx;
  color: #ffffff;
}
.newVip .coupon .station .number {
  font-family: SemiBold;
  font-size: 40rpx;
}
.newVip .coupon .station .info {
  margin-top: 18rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #ffffff;
}
.newVip .coupon .station .button {
  width: 136rpx;
  height: 52rpx;
  border-radius: 26rpx;
  margin: 12rpx auto 0;
  background: #ffffff;
  text-align: center;
  font-weight: 500;
  font-size: 22rpx;
  line-height: 52rpx;
  color: var(--view-theme);
}
.newVip .product .title {
  padding: 28rpx 0 20rpx;
  font-weight: bold;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
}
.newVip .product .list {
  flex-wrap: nowrap;
}
.newVip .product .item {
  width: 158rpx;
  margin-top: 0;
  margin-right: 12rpx;
}
.newVip .product .name {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #333333;
}
.newVip .product .money {
  margin-top: 8rpx;
  text-align: center;
  font-weight: 600;
  font-size: 22rpx;
  color: var(--view-theme);
}
.newVip .product .number {
  font-family: SemiBold;
  font-size: 32rpx;
}
