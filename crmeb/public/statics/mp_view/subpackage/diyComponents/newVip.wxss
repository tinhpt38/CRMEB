}
.newVip2 .header {
  height: 92rpx;
}
.newVip2 .header .info {
  position: relative;
  padding-left: 12rpx;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #ffffff;
}
.newVip2 .header .info::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 1rpx;
  height: 20rpx;
  background-color: #ffffff;
  -webkit-transform: translateY(-50%);
          transform: translateY(-50%);
}
.newVip2 .header .more {
  font-size: 24rpx;
  color: #ffffff;
}
.newVip2 .header .iconfont {
  font-size: 24rpx;
}
.newVip2 .header .image {
  width: 156rpx;
  height: 28rpx;
}
.newVip2 .wrapper {
  border-radius: 16rpx;
  background: #ffffff;
}
.newVip2 .coupon {
  padding-bottom: 20rpx;
}
.newVip2 .coupon .title {
  padding: 24rpx 20rpx 20rpx;
  font-weight: bold;
  font-size: 28rpx;
