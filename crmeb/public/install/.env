APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Ho_Chi_Minh
APP_KEY = crmeb

[DATABASE]
TYPE = mysql
HOSTNAME = localhost
HOSTPORT = 8889
USERNAME = root
PASSWORD = root
DATABASE = crmeb_6.3
PREFIX = crmeb_
CHARSET = utf8mb4
DEBUG = true

[LANG]
default_lang = vi-vn

[CACHE]
DRIVER = file   
CACHE_PREFIX = cache_
CACHE_TAG_PREFIX = cache_tag_

[REDIS]
REDIS_HOSTNAME = #RB_HOST#
PORT = #RB_PORT#
REDIS_PASSWORD = #RB_PWD#
SELECT = #RB_SELECT#

[QUEUE]
QUEUE_NAME = crmeb
