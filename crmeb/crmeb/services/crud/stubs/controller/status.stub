    /**
     * Sửa đổi trạng thái
     * @param $id
     * @return \think\Response
     * @date {%DATE%}
     */
    public function status($id)
    {
        if (!$id) {
            return app('json')->fail('IDkhông thể trống'); 
        }

        $data = $this->request->postMore([
            ['field', ''],
            ['value', '']
        ]);

        $filedAll = {%FIELD_ALL_PHP%};

        if (!in_array($data['field'], $filedAll)) {
            return app('json')->fail('Trường không tồn tại');
        }

        if ($this->service->update(['id'=> $id], [$data['field']=> $data['value']])) {
            return app('json')->success('Sửa đổi thành công');
        } else {
             return app('json')->fail('Sửa đổi không thành công');
        }
    }
