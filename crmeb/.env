APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Ho_Chi_Minh
APP_KEY = crmeb

[DATABASE]
TYPE = mysql
HOSTNAME = localhost
HOSTPORT = 8889
USERNAME = crmeb
PASSWORD = 123456
DATABASE = crmeb_v6.2
PREFIX = eb_
CHARSET = utf8mb4
DEBUG = true

[LANG]
default_lang = vi-VN

[CACHE]
DRIVER = file
CACHE_PREFIX = cache_
CACHE_TAG_PREFIX = cache_tag_

[REDIS]
REDIS_HOSTNAME = #RB_HOST#
PORT = #RB_PORT#
REDIS_PASSWORD = #RB_PWD#
SELECT = #RB_SELECT#

[QUEUE]
QUEUE_NAME = #QUEUE_NAME#
